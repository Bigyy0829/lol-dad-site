{
  "name": "lol-dad-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data:refresh": "powershell -ExecutionPolicy Bypass -File scripts/fetch-data.ps1 && python scripts/fetch-leaguepedia.py && python scripts/build_db.py",
